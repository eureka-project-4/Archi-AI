.env                    # API 키 등 환경변수
user_memories/          # 사용자 개인 대화 기록
chat_history/           # 대화 백업 파일
venv/                   # Python 가상환경
__pycache__/           # Python 캐시 파일
*.pyc                  # 컴파일된 Python 파일
.vscode/               # VS Code 설정
.idea/                 # PyCharm 설정
.DS_Store             # macOS 시스템 파일
Thumbs.db             # Windows 썸네일 파일
.env.docker
.env.local